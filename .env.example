# Copy the values into your shell environment. Never commit a real key.
# Gemini narrative layer (free tier key from https://aistudio.google.com/api-keys, the key named "Event Zero")
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternative name, also accepted
# VirusTotal hash lookup (public API: 4 per minute, 500 per day, non-commercial)
VIRUSTOTAL_API_KEY=
# abuse.ch services: MalwareBazaar, ThreatFox, URLhaus now require a free Auth-Key from https://auth.abuse.ch
ABUSECH_API_KEY=
# Optional enrichment services
HYBRID_ANALYSIS_API_KEY=
OTX_API_KEY=
METADEFENDER_API_KEY=
TRIAGE_API_KEY=
URLSCAN_API_KEY=
# Optional self-hosted CAPE sandbox runner config (the only private-by-default dynamic option)
EVENT_ZERO_SANDBOX_CONFIG=
